{
  "name": "annotator-extension",
  "private": true,
  "version": "0.6.0",
  "scripts": {
    "build": "npm run build:toolbar && npm run build:notes",
    "build:toolbar": "esbuild src/toolbar.jsx --bundle --minify --format=iife --target=chrome120 --define:process.env.NODE_ENV='\"production\"' --define:fetch=bridgeFetch --define:EventSource=BridgeEventSource --inject:src/bridge-main.js --outfile=dist/toolbar.js --legal-comments=none",
    "build:notes": "esbuild src/notes-entry.js --bundle --minify --format=iife --target=chrome120 --define:process.env.NODE_ENV='\"production\"' --define:fetch=bridgeFetch --define:EventSource=BridgeEventSource --inject:src/bridge-main.js --outfile=dist/notes.js --legal-comments=none"
  },
  "devDependencies": {
    "agentation": "3.1.2",
    "esbuild": "0.25.10",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  }
}
