{
  "manifest_version": 3,
  "name": "Annotator",
  "version": "0.6.0",
  "description": "Click any element on any page and leave a note for your coding agent (Agentation toolbar, local or shared notes server).",
  "action": {
    "default_title": "Toggle Annotator (Alt+Shift+A)"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+A"
      },
      "description": "Toggle the annotation toolbar"
    },
    "show-notes": {
      "suggested_key": {
        "default": "Alt+Shift+N"
      },
      "description": "Show all notes on the page (for screenshots)"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_page": "options.html",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "declarativeNetRequestWithHostAccess",
    "contextMenus"
  ],
  "host_permissions": [
    "http://localhost/*",
    "http://127.0.0.1/*",
    "https://github.com/*",
    "https://api.github.com/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ]
}
